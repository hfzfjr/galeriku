# Contoh konfigurasi server Galeriku (placeholder, tanpa rahasia).
# Nilai diisi di UI Coolify (Environment Variables), bukan file ini.
# File .env TIDAK boleh di-commit.
# Koneksi database: Internal URL resource Database Coolify (PostgreSQL 16).
DATABASE_URL=postgresql://<user-db>:<password-db>@<host-internal>:5432/<nama-db>
# Origin frontend untuk CORS backend. Wajib diisi di production.
FRONTEND_ORIGIN=https://galeriku.hafizfajar.com
# Email admin (peran ADMIN ditetapkan setelah verifikasi, US-09b).
# Wajib diisi di production.
ADMIN_EMAIL=admin@contoh.id
# Kuota default akun baru dalam byte (5 GB, angka bulat positif).
DEFAULT_QUOTA_BYTES=5368709120
# Rahasia HMAC hash IP (minimal 32 karakter). Wajib di production.
# Ganti dengan nilai acak yang kuat. File .env TIDAK boleh di-commit.
IP_HASH_SECRET=ganti-dengan-rahasia-minimal-32-karakter
# Kunci rahasia Cloudflare Turnstile. Wajib diisi. Jangan di-commit.
TURNSTILE_SECRET_KEY=ganti-dengan-turnstile-secret-key
# Email kontak admin untuk pesan akun ditangguhkan (opsional).
CONTACT_EMAIL=admin@contoh.id
# Direktori host untuk file media (bind mount ke /data/media).
# Harus path absolut di host, sudah dibuat dan dimiliki uid 1000
# (mkdir -p ... && chown 1000:1000 ...) SEBELUM deploy.
MEDIA_HOST_DIR=/home/hafiz/galeriku-data/media

MAIL_PROVIDER=resend
MAIL_API_KEY=<kunci Resend>
MAIL_FROM=Galeriku <noreply@send.hafizfajar.com>

# Login Google (US-11): client ID + secret dari Google Cloud Console,
# dan URL callback PENUH yang didaftarkan di sana. Wajib diisi
# (container backend menolak start bila kurang).
# Nilai berisi spasi/tanda khusus wajib diapit tanda kutip ganda.
GOOGLE_CLIENT_ID=<client ID Google>
GOOGLE_CLIENT_SECRET=<client secret Google>
GOOGLE_CALLBACK_URL=https://galeriku-api.hafizfajar.com/auth/google/callback