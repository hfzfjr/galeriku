# Alamat dasar API backend (contoh lokal, tanpa rahasia)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Alamat publik situs untuk metadata (canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://galeriku.hafizfajar.com

# Site key publik Cloudflare Turnstile untuk form login/daftar/lupa password
# (bukan rahasia; dipasang di frontend). Minta ke dashboard Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Email kontak untuk halaman Kebijakan Privasi (bukan rahasia).
# Boleh kosong: kalimat berisi email disembunyikan dan build tetap lolos.
NEXT_PUBLIC_CONTACT_EMAIL=
