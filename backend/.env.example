# Port HTTP backend (contoh lokal, tanpa rahasia)
PORT=4000
# Origin frontend yang diizinkan CORS (contoh lokal, tanpa rahasia).
# Wajib diisi dengan origin produksi di server (backend gagal start
# bila NODE_ENV=production dan variabel ini kosong).
FRONTEND_ORIGIN=http://localhost:3000
# Koneksi PostgreSQL (contoh lokal, tanpa rahasia).
# Menunjuk ke postgres dev di 127.0.0.1:5432, lihat "Basis data" di README.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/galeriku
# Email admin: peran ADMIN hanya ditetapkan SETELAH verifikasi (US-09b).
# Di US-09 hanya dibaca ke konfigurasi; pendaftar selalu USER.
# Wajib diisi di production.
ADMIN_EMAIL=admin@contoh.id
# Kuota default akun baru dalam byte (5 GB). Harus angka bulat positif.
DEFAULT_QUOTA_BYTES=5368709120
# Rahasia HMAC untuk hash IP (minimal 32 karakter). Wajib di production.
# Ganti dengan nilai acak yang kuat. JANGAN commit nilai aslinya.
IP_HASH_SECRET=ganti-dengan-rahasia-minimal-32-karakter
# Kunci rahasia Cloudflare Turnstile. Wajib diisi (termasuk dev; untuk
# dev lokal boleh pakai kunci uji Cloudflare). JANGAN commit nilainya.
TURNSTILE_SECRET_KEY=ganti-dengan-turnstile-secret-key
# Email kontak admin untuk pesan akun ditangguhkan (opsional).
CONTACT_EMAIL=admin@contoh.id
